{
  "name": "pdf-contact-extractor",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": "^22.17.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c green,blue \"npm run dev -w frontend\" \"npm run dev -w backend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "start": "node scripts/start.mjs",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "samples": "tsx scripts/generate-samples.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@napi-rs/canvas": "0.1.100",
    "@playwright/test": "^1.58.0",
    "@sparticuz/chromium": "^149.0.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.6",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "4.1.0"
  },
  "overrides": {
    "vite": "$vite",
    "@napi-rs/canvas": "0.1.100"
  },
  "type": "module"
}
