PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Only enable for an Arena preview; use exact origins in production.
ALLOW_PREVIEW_ORIGINS=true
MAX_FILE_SIZE=26214400
MAX_TOTAL_SIZE=104857600
MAX_FILES=10
MAX_PAGES=100
UPLOAD_DIR=./uploads
JOB_TIMEOUT_MS=300000
JOB_TTL_MS=1800000
WORKER_CONCURRENCY=2
MAX_QUEUED_JOBS=8
OCR_LANGUAGE=eng
# Optional directory containing eng.traineddata.gz. Bundled English works offline.
OCR_LANG_PATH=
# 0 trusts loopback only (same-host Next.js); 1 for exactly one trusted proxy.
TRUST_PROXY=0
# Optional, disabled parser extension. No document is sent to an AI provider.
AI_PROVIDER=none
